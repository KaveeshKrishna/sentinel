# ─────────────────────────────────────────────────────────────────────
# Sentinel Agent — Environment Variables
# Copy this file to agent/.env and fill in your values.
#
# agent/ is the privileged host process — the only one with systemctl,
# Docker socket, and /proc/host-path access. It runs as root in
# production (native systemd install). These paths default to the real
# host locations because, unlike the old Docker-container deployment,
# the agent runs natively — there is no bind-mount indirection.
# ─────────────────────────────────────────────────────────────────────

# ── Agent socket + auth ────────────────────────────────────────────
# The installer generates this token and writes it to both this path
# and server/.env's SENTINEL_AGENT_TOKEN_PATH. For local development,
# set SENTINEL_AGENT_TOKEN directly instead — it takes priority.
SENTINEL_AGENT_SOCKET=/run/sentinel/agent.sock
SENTINEL_AGENT_TOKEN_PATH=/etc/sentinel/agent.token
# SENTINEL_AGENT_TOKEN=<dev-only: a random string, must match server/.env>

# ── Host paths (correct defaults for a native install) ─────────────
HOST_PROC=/proc
HOST_SYS=/sys
DISK_TARGET=/
APPS_PATH=/srv/apps
CADDY_FILE=/etc/caddy/Caddyfile
CADDY_LOG=/var/log/caddy/access.log
DOCKER_SOCKET=/var/run/docker.sock

# Comma-separated list of systemd services the agent is allowed to
# observe/control. Leave unset to use the built-in default
# (docker, caddy, cloudflared, ssh, ufw).
# SENTINEL_MANAGED_SERVICES=docker,caddy,cloudflared,ssh,ufw
