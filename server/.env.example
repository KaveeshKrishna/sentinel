# ─────────────────────────────────────────────────────────────────────
# Sentinel Server — Environment Variables
# Copy this file to server/.env and fill in your values.
# Generate hashed password: cd server && node scripts/setup.js
#
# server/ is the unprivileged control plane. It never touches /proc,
# Docker, or systemctl directly — all host access goes through the
# agent over the Unix socket configured below. Host-facing paths
# (HOST_PROC, CADDY_FILE, APPS_PATH, etc.) belong to the agent's own
# config — see agent/.env.example, not this file.
# ─────────────────────────────────────────────────────────────────────

# Authentication (required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=<bcrypt-hash-of-your-password>
JWT_SECRET=<minimum-64-character-random-string>

# Network info (displayed on dashboard)
# Leave blank to auto-detect the primary LAN IP at runtime.
LAN_IP=
PUBLIC_IP=

# Runtime
NODE_ENV=production
PORT=3000

# SQLite database path
DB_PATH=/app/data/sentinel.db

# ── Agent connection ───────────────────────────────────────────────
# Path to the agent's Unix socket and the shared bearer token used to
# authenticate to it. In production the installer writes the token to
# SENTINEL_AGENT_TOKEN_PATH (0640 root:sentinel); for local development
# without the installer, set SENTINEL_AGENT_TOKEN directly instead — it
# takes priority over the file.
SENTINEL_AGENT_SOCKET=/run/sentinel/agent.sock
SENTINEL_AGENT_TOKEN_PATH=/etc/sentinel/agent.token
# SENTINEL_AGENT_TOKEN=<dev-only: paste the agent's token directly>
