# ─────────────────────────────────────────────────────────────────────
# Sentinel — Required Environment Variables
# Copy this file to backend/.env and fill in your values.
# Generate hashed password: cd backend && node scripts/setup.js
# ─────────────────────────────────────────────────────────────────────

# Authentication (required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=<bcrypt-hash-of-your-password>
JWT_SECRET=<minimum-64-character-random-string>

# Network info (displayed on dashboard)
LAN_IP=192.168.1.50
PUBLIC_IP=

# Runtime
NODE_ENV=production
PORT=3000

# Host paths (already correct for the compose.yml bind-mounts)
HOST_PROC=/host/proc
HOST_SYS=/host/sys
APPS_PATH=/srv/apps
DB_PATH=/app/data/sentinel.db
CADDY_FILE=/host/caddy/Caddyfile
CADDY_LOG=/host/var/log/caddy/access.log
